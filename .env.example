# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=openclaw
DB_PASSWORD=openclaw
DB_NAME=openclaw

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Server
SERVER_PORT=3000

# CORS (comma-separated origins, defaults to http://localhost:5173)
CORS_ORIGIN="http://localhost:5173"

# Frontend
VITE_API_PREFIX=/api
VITE_API_BASE_URL="http://localhost:3000"

# Gateway auto-seed (optional)
# When set, the server will auto-create a gateway on first startup if none exists
# GATEWAY_NAME="My Gateway"
# GATEWAY_URL="wss://gateway.example.com"
# GATEWAY_TOKEN="your-token-here"
# GATEWAY_PASSWORD="your-password-here"
