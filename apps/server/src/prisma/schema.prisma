generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum GatewayStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model Agent {
  id          String      @id @default(uuid())
  name        String
  description String      @default("")
  status      AgentStatus @default(ACTIVE)
  config      Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  sessions Session[]

  @@map("agents")
}

model Session {
  id        String        @id @default(uuid())
  agentId   String        @map("agent_id")
  status    SessionStatus @default(ACTIVE)
  metadata  Json          @default("{}")
  startedAt DateTime      @default(now()) @map("started_at")
  endedAt   DateTime?     @map("ended_at")

  agent Agent @relation(fields: [agentId], references: [id])

  @@map("sessions")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  version     String
  enabled     Boolean  @default(true)
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model Gateway {
  id            String        @id @default(uuid())
  name          String
  url           String
  token         String?
  password      String?
  status        GatewayStatus @default(DISCONNECTED)
  lastHeartbeat DateTime?     @map("last_heartbeat")
  config        Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("gateways")
}

model LocalSession {
  id                String    @id
  source            String
  projectSlug       String    @map("project_slug")
  projectPath       String?   @map("project_path")
  model             String?
  gitBranch         String?   @map("git_branch")
  userMessages      Int       @default(0) @map("user_messages")
  assistantMessages Int       @default(0) @map("assistant_messages")
  toolUses          Int       @default(0) @map("tool_uses")
  inputTokens       Int       @default(0) @map("input_tokens")
  outputTokens      Int       @default(0) @map("output_tokens")
  estimatedCost     Float     @default(0) @map("estimated_cost")
  firstMessageAt    DateTime? @map("first_message_at")
  lastMessageAt     DateTime? @map("last_message_at")
  lastUserPrompt    String?   @map("last_user_prompt")
  isActive          Boolean   @default(false) @map("is_active")
  scannedAt         DateTime  @default(now()) @map("scanned_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("local_sessions")
}
